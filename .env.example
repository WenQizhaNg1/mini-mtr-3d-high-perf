POSTGRES_DB=mtr
POSTGRES_USER=mtr
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=15432
MARTIN_PORT=8081
JAVA_API_PORT=3002
REALTIME_ENABLED=true
# Optional HTTP proxy for Java MTR/HKO requests. Empty means direct access.
# Example: OUTBOUND_PROXY_URL=http://127.0.0.1:1083
OUTBOUND_PROXY_URL=
# Optional management API token. Empty disables dataset/style writes.
WORKBENCH_TOKEN=
# Browser-accessible Martin address for generated styles.
MARTIN_PUBLIC_URL=http://127.0.0.1:8081
# Optional absolute path to the repository map directory (for packaged deployment).
# MAP_DIRECTORY=C:/path/to/mini-mtr-3d-high-perf/map
