{
  "name": "mini-greater-bay-area-3d",
  "version": "1.0.0",
  "description": "Hong Kong MTR visualization with Vue, MapLibre and PostGIS",
  "scripts": {
    "data:osm:build": "node scripts/build-osm-mtr.mjs",
    "server:build": "mvn -f backend/pom.xml package",
    "server": "mvn -f backend/pom.xml spring-boot:run",
    "server:java": "mvn -f backend/pom.xml spring-boot:run",
    "front:install": "npm --prefix front install",
    "start": "npm --prefix front run dev",
    "build": "npm --prefix front run build",
    "test:server": "mvn -f backend/pom.xml test",
    "test": "npm --prefix front test && npm run test:server",
    "build:prod": "npm --prefix front run build",
    "test:front": "npm --prefix front test",
    "test:browser": "npm --prefix front run test:browser"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
